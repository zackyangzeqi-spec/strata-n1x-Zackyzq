+// N1X本机接入补丁：仅信任已经登记的单路Strata服务的实际处理进度。
+// 不把心跳时间、请求存活或另一会话的活动当成进度；不改变原停止逻辑。
+export async function loopbackStrataProgress(route, connections, fetcher = fetch) {
+  if (route?.kind !== 'api') return null;
+  const conn = connections.find(c => c.id === route.connectionId);
+  if (!conn || conn.baseUrl.replace(/\/$/, '') !== 'http://127.0.0.1:8095/v1') return null;
+  const get = async path => {
+    const r = await fetcher('http://127.0.0.1:8095' + path, { signal: AbortSignal.timeout(2000), redirect: 'error' });
+    if (!r.ok) throw new Error('Local progress unavailable');
+    return r.json();
+  };
+  try {
+    const s = await get('/v1/status');
+    if (s.service !== 'strata' || !s.loaded || s.model !== route.modelId || s.concurrency?.serving !== 1 || s.activity?.in_flight !== 1) return null;
+    const m = await get('/metrics');
+    const live = m.live;
+    if (m.engine?.model !== route.modelId || !live || !['reading', 'generating'].includes(live.state)) return null;
