+// 本机源码构建的 DeepSeek 专用引擎。保留官方组件校验，不冒充通用或签名发布包。
+import {readFileSync,statSync} from 'node:fs';
+import {createHash} from 'node:crypto';
+import {fileURLToPath} from 'node:url';
+import {resolve} from 'node:path';
+import {execFileSync} from 'node:child_process';
+// 打包的 Node 可以是 x64 仿真进程；用 Windows CPU 架构核实宿主，失败则不启用。
+let arm64Host;
+function isArm64Host(){
+ if(arm64Host!==undefined)return arm64Host;
+ if(process.platform!=='win32')return arm64Host=false;
+ if(process.arch==='arm64')return arm64Host=true;
+ try{
+  const result=execFileSync('powershell.exe',['-NoProfile','-NonInteractive','-Command','(Get-CimInstance Win32_Processor | Select-Object -First 1 -ExpandProperty Architecture)'],{encoding:'utf8',windowsHide:true,timeout:10000});
+  return arm64Host=result.trim()==='12';
+ }catch{return arm64Host=false;}
+}
+const manifestFile=fileURLToPath(new URL('./n1x-native-build.json',import.meta.url));
+const bundledManifest=fileURLToPath(new URL('../../engine-n1x/MANIFEST.json',import.meta.url));
+let cached=null;
+export function localDeepSeekEngine(config){
+ if(config?.arch!=='deepseek41')return null;
+ const engine=localDeepSeekCapability();
+ return engine && typeof config.exe==='string' && resolve(config.exe).toLowerCase()===resolve(engine.exe).toLowerCase() ? engine : null;
+}
+export function localDeepSeekCapability(){
+ if(!isArm64Host())return null;
+ try{
+  let raw,m;
+  try { raw=readFileSync(bundledManifest,'utf8'); m=JSON.parse(raw);
+    const base=resolve(fileURLToPath(new URL('../../engine-n1x/',import.meta.url)));
+    const safe=p=>{if(typeof p!=='string'||! /^[a-zA-Z0-9_.-]+$/.test(p))throw Error('Invalid bundled engine member');return resolve(base,p);};
+    m={...m,exe:safe(m.exe),files:Object.fromEntries(Object.entries(m.files).map(([p,h])=>[safe(p),h]))};
+  } catch(error) { if(error.code!=='ENOENT')throw error; raw=readFileSync(manifestFile,'utf8');m=JSON.parse(raw); }
+  if(m.kind!=='local-source-build'||m.platform!=='windows-arm64'||m.arch!=='deepseek41')return null;
+  const stamp=raw+Object.keys(m.files).map(p=>{const s=statSync(p);return `${p}:${s.size}:${s.mtimeMs}:${s.ctimeMs}`;}).join('|');
+  if(cached?.stamp===stamp)return cached.result;
+  for(const [p,expected] of Object.entries(m.files))if(createHash('sha256').update(readFileSync(p)).digest('hex')!==expected)return null;
+  const pe=readFileSync(m.exe),offset=pe.readUInt32LE(60);
+  if(pe.toString('ascii',offset,offset+4)!=='PE\0\0'||pe.readUInt16LE(offset+4)!==0xaa64)return null;
+  const result={usable:true,source:'local-source-build',version:m.version,platform:m.platform,backend:'cuda',exe:m.exe,notice:'Windows ARM64 CUDA · 本机源码构建，仅 DeepSeek；短请求已验，1M 长输入未验。'};
+  cached={stamp,result};return result;
+ }catch{return null;}
+}
