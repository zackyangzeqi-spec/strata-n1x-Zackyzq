+    if (!Number.isFinite(read) || read < 0 || !Number.isFinite(generated) || generated < 0) return null;
+    return { request: s.activity.last_request_at, read, generated, total: live.prompt_total ?? live.prompt_tokens };
+  } catch { return null; }
+}
+
+export function progressed(previous, next) {
+  if (!next) return false;
+  if (!previous) return next.read > 0 || next.generated > 0;
+  // 当前请求身份不变时才续期，防止另一客户端的请求延长本次等待。
+  return next.request === previous.request && next.total === previous.total &&
+    (next.read > previous.read || next.generated > previous.generated);
+}
