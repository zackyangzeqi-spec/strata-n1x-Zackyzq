+// N1X 模型页仅修改 DeepSeek 支持的启动参数，不生成 Qwen 参数或触发下载。
+export function flagValue(args, flag) { const at=(args??[]).indexOf(flag); return at>=0?args[at+1]:undefined; }
+function setFlag(args,flag,value) {
+ const out=[];for(let i=0;i<(args??[]).length;i++){if(args[i]===flag){i++;continue;}out.push(args[i]);}
+ out.push(flag,String(value));return out;
+}
+export function applyN1xModelSettings(config,requested,contextLimit) {
+ let next={...config,args:[...(config.args??[])]};
+ if(requested.n1xContext!==undefined){
+  const n=Number(requested.n1xContext),limit=Number(contextLimit);
+  if(!Number.isSafeInteger(n)||n<1024||!Number.isFinite(limit)||n>limit)throw new Error('上下文超出当前模型配置支持范围。');
+  next.args=setFlag(next.args,'--max-context',n);
+ }
+ if(requested.n1xDrafting!==undefined){
+  if(!['auto','on','off'].includes(requested.n1xDrafting))throw new Error('DeepSeek 预测草稿只支持 DSpark auto/on/off。');
+  next.args=setFlag(next.args,'--dspark',requested.n1xDrafting);
+ }
+ return next;
+}
