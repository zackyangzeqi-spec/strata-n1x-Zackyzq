+// 本机Linux Strata的生命周期适配：复用官方服务，不创建或伪装Windows引擎。
+export const ATTACHED_ID='n1x-linux-1017';
+export function createN1xAttachment(fetcher=fetch) {
+  const base='http://127.0.0.1:8095';
+  let propsStarted=null,modelPath=null;
+  async function call(path,options={}) {
+    const r=await fetcher(base+path,{redirect:'error',signal:AbortSignal.timeout(3000),...options});
+    const data=await r.json();if(!r.ok)throw Error(data.error?.message??'Linux Strata服务不可用');return data;
+  }
+  async function status() {
+    const s=await call('/v1/status');
+    if(s.service!=='strata'||s.model!=='deepseek-v4.1-flash'||s.engine!=='ds4-0.1'||s.concurrency?.serving!==1)throw Error('本机Strata服务身份或单路配置不匹配');
+    return s;
+  }
+  async function instance() {
+    const s=await status();if(!s.loaded)return null;
+    const metrics=await call('/metrics');if(metrics.engine?.model!==s.model)throw Error('指标模型不匹配');
+    // 量化名称取自正在运行的引擎路径，不从待启用配置猜测。每次服务重启后重新读取。
+    if(propsStarted!==s.started){const props=await call('/props');modelPath=props.model_alias===s.model&&typeof props.model_path==='string'?props.model_path:null;propsStarted=s.started;}
+    const quant=modelPath?.match(/deepseek-v4\.1-flash-ist-das-(\d+\.\d+)bpw(?:\/|$)/)?.[1];
+    return {id:ATTACHED_ID,apiModelId:s.model,model:ATTACHED_ID,label:`DeepSeek 1017${quant?' · '+quant+'bpw':''} · Strata本地（Linux）`,context:s.context?.max_positions??s.cache_max_tokens,port:8095,gpus:[0],status:'ready',phase:metrics.live?.state??'idle',parallel:1,vision:s.vision?.enabled===true,key:'',aliases:[],mcpServers:{},metrics,modelPath,attachedLinux:true,notice:'使用本机WSL Linux ARM64 Strata引擎；参数来自strata-service.json；不使用Windows模型页的资源滑块。',loadedAt:new Date(s.started*1000).toISOString()};
+  }
+  async function unload() {
+    const s=await status();if(s.activity?.in_flight)throw Error('Linux服务仍有请求，请先完成或取消');
+    const r=await call('/v1/unload',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({model:s.model}),signal:AbortSignal.timeout(60000)});
+    if(r.loaded!==false||(await status()).loaded!==false)throw Error('服务尚未确认卸载');return r;
+  }
+  return {instance,status,unload};
+}
