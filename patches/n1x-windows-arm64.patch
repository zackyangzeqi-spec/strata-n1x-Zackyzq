+import { useEffect, useState } from 'react';
+import { api } from '../lib/client';
+import type { Hardware } from '../lib/types';
+import type { NativeInstance } from '../lib/native';
+
+// 沿用原生“这台电脑”的卡片和计量条；N1X 使用整机实测，不能冒充模型独占估算。
+function Meter({label,total,bytes}:{label:string;total:number;bytes:unknown}) {
+  const used=typeof bytes==='number' && Number.isFinite(bytes) ? bytes/2**30 : null;
+  const pct=used===null || total<=0 ? 0 : Math.max(0,Math.min(100,used/total*100));
+  return <div className="pc-meter"><div className="pc-meter__top"><span>{label}</span><b>{used===null ? '—' : `${used.toFixed(1)} GiB`}</b><span className="muted">共 {total.toFixed(1)} GiB</span></div><div className="pc-meter__track" role="img" aria-label={`${label}：${used===null ? '尚无实测' : `${used.toFixed(1)} GiB`}`}><i style={{width:`${pct}%`}}/></div></div>;
+}
+export function N1xRuntimeCard({instance,gpuName,ramGb,vramGb,hardware,measuredHardware}:{hardware?:Hardware|null;measuredHardware?:Record<string,any>;instance?:NativeInstance;gpuName?:string|null;ramGb:number|null;vramGb:number}) {
+  const [snapshot,setSnapshot]=useState<Hardware|null>(hardware??null);
+  useEffect(()=>{let alive=true; if(!measuredHardware)void api.get<Hardware>('/api/hardware?reprobe=1').then(h=>{if(alive)setSnapshot(h);}).catch(()=>{});return()=>{alive=false;};},[!!measuredHardware]);
+  const gpu=snapshot?.gpus.find(g=>/N1X/i.test(g.name));
+  const h=instance?.metrics?.hardware ?? measuredHardware ?? {ram_used:snapshot ? snapshot.memory.usedGb*2**30 : null,gpu_mem_used:gpu?.freeVramGb!=null ? (gpu.vramGb-gpu.freeVramGb)*2**30 : null}, e=instance?.metrics?.engine;
+  const last=instance?.metrics?.requests?.find((r:{drafts_offered?:number})=>(r.drafts_offered ?? 0)>0);
+  return <section className="st-card pc-card">
+    <div><h2 className="h4">这台电脑</h2><p className="small muted">{gpuName} · {vramGb} GiB 显存 · {ramGb?.toFixed(1) ?? '未知'} GiB 内存</p></div>
+    <Meter label={measuredHardware ? "显存 · 整机实测" : "显存 · 最近检测"} total={vramGb} bytes={h?.gpu_mem_used}/>
+    <Meter label={measuredHardware ? "RAM · 整机实测" : "RAM · 最近检测"} total={ramGb ?? 0} bytes={h?.ram_used}/>
+    <p className="pc-note">{instance ? '当前版本已加载。以上包含系统和其他应用占用，并非模型独占。' : measuredHardware ? '当前选中版本未加载；以上为整机实测，包含其他已加载版本。' : `当前版本未加载。最近检测：${snapshot?.probedAt ? new Date(snapshot.probedAt).toLocaleTimeString() : '待获取'}；不是模型加载后的预计占用。`}</p>
+    <details className="small muted"><summary>运行详情</summary><p>统一物理内存的不同统计口径不直接相加。</p><p>当前上下文：{instance?.context?.toLocaleString() ?? '未加载'} tokens<br/>KV：{e?.kv ?? '待引擎报告'}<br/>草稿元数据：{e?.drafting ?? '待引擎报告'}{last ? <><br/>最近草稿：接受 {last.drafts_accepted} / 提议 {last.drafts_offered}{e?.drafting === 'off' ? '（元数据未反映 DSpark 活动）' : ''}</> : null}</p></details>
+  </section>;
+}
